# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

OPENAI_API_KEY=""
JINA_API_KEY=""
ADMIN_API_TOKEN=""        # secret token for REST API auth — pick any string
ADMIN_PASSWORD=""         # password for the Documents admin section in UI
JWT_SECRET=""             # random secret for signing JWT tokens — pick any long random string
MILVUS_URI="http://standalone:19530"   # Docker network name; use http://localhost:19530 for dev.sh

# Frontend build args (baked into JS bundle at build time)
VITE_API_URL="http://localhost:8000"   # backend URL as seen from the browser
VITE_API_KEY=""           # same value as ADMIN_API_TOKEN
